    "concurrently": "^9.2.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@octokit/app": "^16.1.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^21.1.1",
    "@sentry/node": "^9.47.1",
    "@unkey/api": "^0.36.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
